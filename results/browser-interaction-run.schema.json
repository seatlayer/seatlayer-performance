{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seatlayer.io/performance/schemas/browser-interaction-run.v1.json",
  "title": "SeatLayer manual browser interaction run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "scope",
    "startedAt",
    "completedAt",
    "durationMs",
    "sdk",
    "fixture",
    "readiness",
    "client",
    "network",
    "frameSummary",
    "rawFrameIntervalsMs",
    "limitations"
  ],
  "properties": {
    "schema": { "const": "seatlayer.browser-interaction-run.v1" },
    "status": { "enum": ["measured", "aborted"] },
    "scope": { "type": "string", "minLength": 1 },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durationMs": { "type": "number", "minimum": 0 },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "url"],
      "properties": {
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "fixture": {
      "type": "object",
      "required": ["id", "name", "version", "file", "sha256", "seats", "sections", "loadAndVerifyMs"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "seats": { "const": 100000 },
        "sections": { "type": "integer", "minimum": 1 },
        "loadAndVerifyMs": { "type": "number", "minimum": 0 }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderPromiseMs", "analytics", "boundary"],
      "properties": {
        "renderPromiseMs": { "type": "number", "minimum": 0 },
        "analytics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["event", "observedMs"],
            "properties": {
              "event": { "enum": ["chart_rendered", "chart_seats_revealed"] },
              "observedMs": { "type": "number", "minimum": 0 }
            }
          }
        },
        "boundary": { "type": "string", "minLength": 1 }
      }
    },
    "client": {
      "type": "object",
      "required": ["userAgent", "hardwareConcurrency", "viewport", "remainedForeground"],
      "properties": {
        "userAgent": { "type": "string", "minLength": 1 },
        "hardwareConcurrency": { "type": ["integer", "null"], "minimum": 1 },
        "viewport": {
          "type": "object",
          "required": ["width", "height", "devicePixelRatio"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "remainedForeground": { "type": "boolean" }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixtureCache", "throttling"],
      "properties": {
        "fixtureCache": { "const": "no-store" },
        "throttling": { "type": "string", "minLength": 1 }
      }
    },
    "frameSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["samples", "p50FrameMs", "p95FrameMs", "maxFrameMs", "frameThresholdMs", "framesOverThreshold"],
      "properties": {
        "samples": { "type": "integer", "minimum": 1 },
        "p50FrameMs": { "type": "number", "minimum": 0 },
        "p95FrameMs": { "type": "number", "minimum": 0 },
        "maxFrameMs": { "type": "number", "minimum": 0 },
        "frameThresholdMs": { "const": 33.4 },
        "framesOverThreshold": { "type": "integer", "minimum": 0 }
      }
    },
    "rawFrameIntervalsMs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "number", "minimum": 0 }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
