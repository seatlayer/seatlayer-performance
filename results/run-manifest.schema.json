{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://seatlayer.io/performance/schemas/run-manifest.v1.json",
  "title": "SeatLayer large-venue performance run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "status",
    "recordedAt",
    "environment",
    "applicationRelease",
    "sdkVersion",
    "fixture",
    "client",
    "network",
    "rawArtifact"
  ],
  "properties": {
    "schema": {
      "const": "seatlayer.large-venue-performance.v1"
    },
    "kind": {
      "enum": ["renderer", "simultaneous-viewers"]
    },
    "status": {
      "enum": ["warmup", "measured", "failed", "aborted"]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "enum": ["local-production-build", "deployed-production"]
    },
    "applicationRelease": {
      "type": "string",
      "minLength": 1
    },
    "sdkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "seats", "sections"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "seats": { "type": "integer", "minimum": 0 },
        "sections": { "type": "integer", "minimum": 0 }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": ["browser", "os", "hardware", "viewport", "foreground"],
      "properties": {
        "browser": { "type": "string", "minLength": 1 },
        "os": { "type": "string", "minLength": 1 },
        "hardware": { "type": "string", "minLength": 1 },
        "viewport": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "devicePixelRatio"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "devicePixelRatio": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "foreground": { "const": true }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cacheState", "throttling", "connection"],
      "properties": {
        "cacheState": { "enum": ["cold", "warm", "uncontrolled"] },
        "throttling": { "type": "string", "minLength": 1 },
        "connection": { "type": "string", "minLength": 1 }
      }
    },
    "rawArtifact": {
      "type": "string",
      "pattern": "^raw/.+\\.json$"
    },
    "notes": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
